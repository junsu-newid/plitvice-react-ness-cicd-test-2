{
    "name": "plitvice-react",
    "version": "0.0.0",
    "description": "plitvice monorepo",
    "private": true,
    "type": "module",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "scaffolding": "node script/template-copy-script.mjs",
        "prettier": "prettier --write .",
        "prepare": "husky",
        "lint": "eslint .",
        "format": "prettier --write .",
        "@plitvice/ui": "pnpm --filter @plitvice/ui",
        "ness:dev": "pnpm --filter @plitvice/ness dev",
        "ness:build": "pnpm --filter @plitvice/ness build",
        "paro:dev": "pnpm --filter @plitvice/paro dev",
        "paro:build": "pnpm --filter @plitvice/paro build",
        "dev:all": "pnpm run --parallel ness:dev paro:dev",
        "build:all": "pnpm run --parallel ness:build paro:build"
    },
    "author": "NEWID",
    "license": "ISC",
    "packageManager": "pnpm@10.5.2",
    "dependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router": "^7.3.0",
        "styled-components": "^6.1.15",
        "jotai": "^2.12.1"
    },
    "devDependencies": {
        "@eslint/js": "catalog:",
        "eslint": "catalog:",
        "eslint-config-prettier": "catalog:",
        "eslint-plugin-prettier": "catalog:",
        "eslint-plugin-react": "catalog:",
        "eslint-plugin-react-hooks": "catalog:",
        "eslint-plugin-react-refresh": "catalog:",
        "husky": "catalog:",
        "lint-staged": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^4.3.4",
        "vite": "^6.2.1",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "lint-staged": {
        "**/*.{js,ts,tsx}": "eslint --fix",
        "**/*.{js,ts,tsx,json,css,md}": "prettier --write"
    }
}
